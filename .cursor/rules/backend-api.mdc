## Api and ApiContext

```python

@dataclass
class ApiContext:
    database: SomeDB
    additional_client: AdditionalClient

class Api:
    def __init__(
        self, settings: ApiSettings, log_config: dict, ctx: ApiContext
    ):
        self.settings = settings
        self.api = FastAPI(docs_url=None)
        self.api.state.context = ctx

        config = Config(
            self.api,
            settings.host,
            settings.port,
            log_config=log_config,
        )
        self.server = Server(config)

        self._set_cors()
        self._set_exception_handler()

    def _set_cors(self) -> None:
        cors_config = read_yaml_model(self.settings.cors_path, CorsConfig)
        self.api.add_middleware(CORSMiddleware, **cors_config.model_dump())

    def _set_exception_handler(self):
        self.api.add_exception_handler(Exception, default_exception_handler)

    def include_router(self, *args, **kwargs):
        self.api.include_router(*args, **kwargs)
```

## Dependencies

```python
from typing import Annotated

from fastapi import Depends, HTTPException, Request

from .api import ApiContext


async def get_api_context(request: Request):
    return request.app.state.context


ApiContextDepends = Annotated[
    ApiContext,
    Depends(get_api_context),
]


async def is_user_authorized(ctx: ApiContextDepends):
    if not await ctx.some_client.is_user_authorized():
        raise HTTPException(status_code=400, detail="User not authorized")


UserAuthorisedDepends = Annotated[
    None,
    Depends(is_user_authorized),
]
```

## Router aggregate

```python
from fastapi import APIRouter

from . import test_routes, home_routes

router = APIRouter()

router.include_router(test_routes.router)
router.include_router(home_routes.router)
```

## test routes

```python
from fastapi import APIRouter

from app.api.dependencies import ApiContextDepends, UserAuthorisedDepends

router = APIRouter()


@router.get("/test")
async def test(ctx: ApiContextDepends):
    print(ctx.number)
    return {"message": "Hello, World!"}


@router.get("/test2")
async def test2(user: UserAuthorisedDepends):
    print(user)
    return {"message": "Hello, World!"}
```

